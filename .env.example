# Kavosh - copy to backend/.env and fill in.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Database ---------------------------------------------------------------
# Set this: the built-in default connects as the original developer's local user.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/research

# --- Embedding model (must be 384-d: all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5,
#     hash-ngram:384). Changing it invalidates cached vectors for the old model.
# EMBED_MODEL=all-MiniLM-L6-v2

# --- Retrieval --------------------------------------------------------------
# HYBRID_RETRIEVAL=1          # on by default: BM25 + dense fused with RRF; set 0 to use dense only
# ARXIV_CANDIDATES=50
# ARXIV_MIN_INTERVAL=3          # seconds between arXiv requests
# ARXIV_CACHE_TTL_HOURS=6       # reuse a topic's arXiv results
# ARXIV_COOLDOWN_SECONDS=60     # pause arXiv calls after a 429
# SEARCH_RATE_LIMIT_PER_MIN=10  # per visitor; 0 turns it off
# SEARCH_GLOBAL_LIMIT_PER_MIN=30  # all visitors together; 0 turns it off
# ARXIV_HTTP_TIMEOUT=20         # seconds per arXiv request
# ARXIV_LOCK_WAIT=45            # max seconds a search waits for the shared arXiv slot
# INSIGHT_BATCH_SIZE=8          # papers per LLM summary call
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://btp-sem-07.vercel.app
# CORS_ORIGIN_REGEX=https://btp-sem-07(-[a-z0-9-]+)?\.vercel\.app
# EXPOSE_DOCS=0                 # 1 = serve /docs, /openapi.json and /metrics through the tunnel too

# --- Thresholds (run `python -m eval.calibrate_thresholds` for measured values)
# CACHE_TOP_SCORE=0.40
# CACHE_STRONG_SCORE=0.35
# CACHE_TTL_HOURS=12
# CALIB_BETA_SHORT=0.30
# CALIB_BETA_LONG=0.35

# HuggingFace token (optional - speeds up model downloads)
# HF_TOKEN=
