# Kavosh - copy to backend/.env and fill in.

# --- Required ---------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Database ---------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/research

# --- Embedding model (must be 384-d: all-MiniLM-L6-v2, BAAI/bge-small-en-v1.5,
#     hash-ngram:384). Changing it invalidates cached vectors for the old model.
# EMBED_MODEL=all-MiniLM-L6-v2

# --- Retrieval --------------------------------------------------------------
# HYBRID_RETRIEVAL=1          # on by default: BM25 + dense fused with RRF; set 0 to use dense only
# ARXIV_CANDIDATES=50

# --- Thresholds (run `python -m eval.calibrate_thresholds` for measured values)
# CACHE_TOP_SCORE=0.40
# CACHE_STRONG_SCORE=0.35
# CACHE_TTL_HOURS=12
# CALIB_BETA_SHORT=0.30
# CALIB_BETA_LONG=0.35

# HuggingFace token (optional - speeds up model downloads)
# HF_TOKEN=
